# CoDesk Catalog Microservice - Environment Template
NODE_ENV=production
PORT=5005
TZ=Asia/Colombo

# Database Connection (Internal MySQL container on inzeedo_network or 127.0.0.1 for local)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=codesk_catalog_system
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_DIALECT=mysql
DB_LOGGING=false
DB_SLOW_QUERY_MS=500
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Security Key between pos_api and codesk_catalog_service
MASTER_API_KEY=YOUR_RANDOM_SECRET_KEY_HERE
RATE_LIMIT_MAX_REQUESTS=500
RATE_LIMIT_WINDOW_MS=60000
